{#
  Cloud Custodian policy template for the Red Hat Discovery AWS account.

  Rendered by deploy.sh or render-policy.py — do not edit policy.yml or
  policy-dryrun.yml directly; edit this file instead.

  Variables:
    account_id  — AWS account ID (12-digit string)
    dryrun      — boolean; True = observation only (no destructive actions)

  In dry-run mode:
    - Policy names carry a "-dryrun" suffix so live and dry-run Lambdas
      can coexist without name collision.
    - All actions blocks are empty (resources are identified but not acted on).
#}
{% set suffix = '-dryrun' if dryrun else '' %}
---
vars:
  role: &role arn:aws:iam::{{ account_id }}:role/custodian-cleanup-role

  # Skips any resource tagged custodian:ignore = true.
  # Apply this tag to anything that must never be touched automatically
  # (Jenkins AMIs, long-lived supporting services, etc.).
  keep-filter: &keep-filter
    type: value
    key: "tag:custodian:ignore"
    value: "true"
    op: ne

  # Skips EC2 instances tagged custodian:no-terminate = true.
  # These are "pet" instances: they will be stopped if left running too long,
  # but will NEVER be terminated regardless of how long they remain stopped.
  # Use this tag for instances you need to keep around but don't want running
  # unattended over weekends or holidays.
  no-terminate-filter: &no-terminate-filter
    type: value
    key: "tag:custodian:no-terminate"
    value: "true"
    op: ne

policies:

  # ════════════════════════════════════════════════════════════════════════════
  # EC2 INSTANCES
  # ════════════════════════════════════════════════════════════════════════════

  # Stops "pet" instances (custodian:no-terminate = true) that have been running
  # for 24+ hours. These instances are never terminated — only stopped — so
  # they can be restarted manually when needed.
  - name: stop-long-running-pet-ec2{{ suffix }}
    resource: ec2
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - State.Name: running
      - type: value
        key: "tag:custodian:no-terminate"
        value: "true"
        op: eq
      - type: instance-uptime
        op: ge
        days: 1
    actions:
{% if dryrun %}
      []
{% else %}
      - stop
{% endif %}


  # Terminates running instances older than 7 days that are not ignore and not
  # no-terminate. CI instances are disposable; 7 days is a generous grace period.
  - name: terminate-stale-running-ec2{{ suffix }}
    resource: ec2
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - State.Name: running
      - *keep-filter
      - *no-terminate-filter
      - type: instance-age
        op: ge
        days: 7
    actions:
{% if dryrun %}
      []
{% else %}
      - terminate
{% endif %}


  # Terminates stopped instances whose most recent LaunchTime is more than
  # 3 days ago, and are not ignore or no-terminate. A stopped instance still
  # incurs EBS volume costs.
  #
  # IMPORTANT: instance-age measures LaunchTime (last start time), NOT time
  # in the stopped state. An instance that ran for 3 days and was stopped
  # 10 minutes ago WILL be terminated on the next daily run. Tag any instance
  # you intend to stop temporarily with custodian:no-terminate=true to prevent
  # automatic termination regardless of age.
  #
  # no-terminate instances are explicitly excluded: they may remain stopped
  # indefinitely and must never be terminated automatically.
  - name: terminate-stale-stopped-ec2{{ suffix }}
    resource: ec2
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - State.Name: stopped
      - *keep-filter
      - *no-terminate-filter
      - type: instance-age
        op: ge
        days: 3
    actions:
{% if dryrun %}
      []
{% else %}
      - terminate
{% endif %}


  # ════════════════════════════════════════════════════════════════════════════
  # EBS VOLUMES & SNAPSHOTS
  # ════════════════════════════════════════════════════════════════════════════

  # Deletes unattached volumes older than 3 days that are not ignore.
  # Volumes in "available" state are not attached to any instance.
  - name: delete-unattached-volumes{{ suffix }}
    resource: ebs
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - State: available
      - *keep-filter
      - type: value
        key: CreateTime
        value_type: age
        value: 3
        op: ge
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}


  # Deletes our own snapshots older than 7 days that are not ignore.
  # c7n automatically skips snapshots still backing a registered AMI.
  - name: delete-old-snapshots{{ suffix }}
    resource: ebs-snapshot
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: age
        op: ge
        days: 7
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}


  # ════════════════════════════════════════════════════════════════════════════
  # AMIs
  # ════════════════════════════════════════════════════════════════════════════

  # Deregisters our own AMIs older than 90 days that are not ignore.
  # delete-snapshots: true also removes the EBS snapshots backing the AMI.
  # IMPORTANT: tag any AMI actively referenced by a running configuration with
  # custodian:ignore = true to prevent premature deregistration.
  - name: deregister-old-amis{{ suffix }}
    resource: ami
    mode:
      type: periodic
      schedule: "rate(7 days)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: image-age
        op: ge
        days: 90
    actions:
{% if dryrun %}
      []
{% else %}
      - type: deregister
        delete-snapshots: true
{% endif %}


  # ════════════════════════════════════════════════════════════════════════════
  # NETWORKING
  # ════════════════════════════════════════════════════════════════════════════

  # Releases unassociated Elastic IPs that are not ignore.
  # Unassociated EIPs cost ~$3.65/month each.
  #
  # Note: Unlike ENIs and NAT gateways, the AWS EIP API (DescribeAddresses)
  # exposes no creation or disassociation timestamp, so no minimum-age filter
  # is possible here. There is a narrow theoretical race: an EIP disassociated
  # to move between instances could be released if the daily Lambda fires during
  # that brief window (~1/1440 probability). The risk is accepted given the daily
  # schedule and the complexity of the alternative (a mark-for-op two-policy
  # approach). Tag any EIP in active transition with custodian:ignore=true to
  # guarantee it is skipped.
  - name: release-unassociated-eips{{ suffix }}
    resource: elastic-ip
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: value
        key: AssociationId
        value: absent
    actions:
{% if dryrun %}
      []
{% else %}
      - type: release
{% endif %}


  # Deletes detached (available) ENIs older than 1 day that are not ignore.
  # ENIs are left behind after instance termination. The 1-day age avoids
  # false positives from services that create ENIs transiently.
  - name: delete-detached-enis{{ suffix }}
    resource: eni
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: value
        key: Status
        value: available
      - type: value
        key: OwnerId
        value: "{{ account_id }}"
      - not:
          - type: value
            key: Description
            value: "^ELB |^AWS Lambda VPC ENI|^RDSNetworkInterface|^arn:aws:ecs|^VPC Endpoint Interface"
            op: regex
      - type: value
        key: CreateTime
        value_type: age
        value: 1
        op: ge
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}


  # Deletes NAT gateways older than 3 days that are not ignore.
  # NAT gateways cost ~$32/month plus data charges.
  - name: delete-old-nat-gateways{{ suffix }}
    resource: nat-gateway
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - State: available
      - type: value
        key: CreateTime
        value_type: age
        op: ge
        value: 3
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}


  # ════════════════════════════════════════════════════════════════════════════
  # SECURITY GROUPS & KEY PAIRS
  # ════════════════════════════════════════════════════════════════════════════

  # Deletes security groups not attached to any resource that are not ignore.
  # The AWS console creates a new security group by default each time you step
  # through the "Launch Instance" wizard.
  # Note: the default VPC security group cannot be deleted; AWS rejects it.
  - name: delete-unused-security-groups{{ suffix }}
    resource: security-group
    mode:
      type: periodic
      schedule: "rate(1 day)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: unused
      - type: value
        key: GroupName
        value: default
        op: ne
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}


  # Deletes key pairs not associated with any running or stopped EC2 instance
  # or ASG launch configuration that are not ignore.
  # c7n enforces that the `unused` filter must be present in this policy.
  - name: delete-unused-key-pairs{{ suffix }}
    resource: key-pair
    mode:
      type: periodic
      schedule: "rate(7 days)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: unused
        state: true
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}


  # ════════════════════════════════════════════════════════════════════════════
  # CLOUDWATCH LOG GROUPS
  # ════════════════════════════════════════════════════════════════════════════

  # Deletes log groups that have had no activity in 30 days.
  # These accumulate from deleted Lambda functions, terminated EC2 instances
  # running CloudWatch agents, and removed custodian policies.
  - name: delete-stale-log-groups{{ suffix }}
    resource: log-group
    mode:
      type: periodic
      schedule: "rate(7 days)"
      role: *role
      runtime: python3.11
    filters:
      - *keep-filter
      - type: last-write
        days: 30
    actions:
{% if dryrun %}
      []
{% else %}
      - delete
{% endif %}
